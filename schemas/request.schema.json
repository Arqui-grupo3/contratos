{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arqui-grupo3/contratos/raw/refs/heads/master/schemas/request.schema.json",
  "title": "EnergyShark E1 - request",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "request"
        },
        "data": {
          "type": "object",
          "properties": {
            "ask": {
              "$ref": "common.schema.json#/$defs/text"
            }
          },
          "required": [
            "ask"
          ]
        }
      },
      "type": "object"
    }
  ]
}
